<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Impresión Exitosa - Movitek</title>
    <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
    <script>
          if (window.history && window.history.replaceState) {
              window.history.replaceState(null, null, window.location.href);
            }
    </script>
    <script>
    // Empuja un estado falso al historial para capturar el botón atrás de Android
     history.pushState(null, null, location.href);
     window.addEventListener('popstate', function () {
        // Si presionan atrás, los mandamos de golpe al inicio limpio
        window.location.replace('/');
      });
     </script>
</head>
<body>
    <div class="container">
        <div class="brand-header">Tecnología <span>Movitek</span></div>
        <h1>✅ ¡Imprimiendo!</h1>
        <p>Tu pago ha sido aprobado. El documento se está imprimiendo en este momento.</p>
        
        <a href="/" class="btn-primary" style="margin-top: 25px;">Imprimir otro archivo</a>
    </div>

    <script> 
        window.addEventListener("pageshow", function (event) {
            if (event.persisted || (performance.navigation && performance.navigation.type === 2)) {
                window.location.replace('/'); // <-- Esto limpia el historial y te manda al inicio sin reenvíos
            }
        });
    </script>
</body>
</html>
